{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "UseJsonConsole": false
  },
  "ConnectionStrings": {
    "NotificationsConnection": "Host=localhost;Port=5434;Database=orderflow_notifications;Username=postgres;Password=postgres"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "orderflow.orders",
    "ExchangeType": "topic",
    "QueueName": "orderflow.notifications",
    "DeadLetterExchangeName": "orderflow.notifications.dlx",
    "DeadLetterExchangeType": "direct",
    "DeadLetterQueueName": "orderflow.notifications.dlq",
    "DeadLetterRoutingKey": "orderflow.notifications.dlq",
    "MaxRetryAttempts": 3,
    "InitialRetryDelayMs": 500,
    "Durable": true,
    "PrefetchCount": 10
  }
}
