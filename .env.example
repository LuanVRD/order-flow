# ==============================================================================
# OrderFlow Environment Configuration (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme necessário.
# ==============================================================================

# --- Orders PostgreSQL Database ---
ORDERS_DB_PORT=5433
ORDERS_DB_NAME=orderflow_orders
ORDERS_DB_USER=postgres
ORDERS_DB_PASSWORD=postgres

# --- Notifications PostgreSQL Database ---
NOTIFICATIONS_DB_PORT=5434
NOTIFICATIONS_DB_NAME=orderflow_notifications
NOTIFICATIONS_DB_USER=postgres
NOTIFICATIONS_DB_PASSWORD=postgres

# --- RabbitMQ Message Broker ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Orders API Service ---
ORDERS_API_PORT=5000
ASPNETCORE_ENVIRONMENT=Development
SERILOG_USE_JSON_CONSOLE=false
